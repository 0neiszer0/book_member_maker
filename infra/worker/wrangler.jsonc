{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "main": "proxy.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "observability": {"enabled": false},
  "build": {"command": "node prepare-assets.mjs"},
  "assets": {
    "directory": "./.versioned-assets",
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "UPSTREAM_ORIGIN": "https://origin.knu-read.xyz",
    "PUBLIC_BASE_URL": "https://knu-read.xyz",
    "LEGACY_PUBLIC_ORIGIN": "https://www.knu-read.workers.dev"
  }
}
