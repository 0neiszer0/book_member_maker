[Unit]
Description=Bookmembers local database and file API
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/bookmembers-db
ExecStart=/usr/bin/docker compose --env-file database.env -f compose.yaml -p bookmembers-db up -d --wait --wait-timeout 120
ExecStop=/usr/bin/docker compose --env-file database.env -f compose.yaml -p bookmembers-db stop
Restart=on-failure
RestartSec=15
TimeoutStartSec=150
TimeoutStopSec=90
UMask=0077

[Install]
WantedBy=multi-user.target
