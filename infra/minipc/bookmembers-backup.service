[Unit]
Description=Encrypted book members database and Storage backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/bookmembers-backup
ExecStart=/opt/book_member_maker/.venv/bin/python /opt/bookmembers-backup/infra/minipc/run_scheduled_backup.py
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bookmembers-backup /var/lib/bookmembers-health /etc/book_member_maker
# Install only after approval of persistent Drive access and scheduling.
