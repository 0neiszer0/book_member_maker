[Unit]
Description=Encrypted book members database and Storage backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/book_member_maker
ExecStart=/opt/book_member_maker/.venv/bin/python /opt/book_member_maker/infra/minipc/backup.py --run
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bookmembers-backup /etc/book_member_maker
