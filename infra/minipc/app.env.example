# Copy outside Git to /etc/book_member_maker/app.env; root:root 0600.
# Preserve the existing FLASK_SECRET_KEY. Enter secrets locally, never in chat.
FLASK_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Enable only after local DB cutover; keep false for hosted Supabase.
LOCAL_STORAGE_PROXY=false
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
PUBLIC_BASE_URL=
SESSION_COOKIE_SECURE=true
REQUIRE_ORIGIN_AUTH=true
ORIGIN_AUTH_SECRET=
# Transitional Render origin only if explicitly needed; exact HTTPS origin.
ADDITIONAL_ALLOWED_ORIGINS=
# Preserve these only if enabled on the current server. Never copy values into Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
