[Unit]
Description=Book members private openNamu engine
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=bookapp
Group=bookapp
WorkingDirectory=/var/lib/bookmembers-wiki
EnvironmentFile=/etc/bookmembers-wiki/engine.env
Environment=GOMEMLIMIT=192MiB
ExecStart=/opt/bookmembers-wiki/opennamu 5096 --localhost
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bookmembers-wiki
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
