# Future Ubuntu host only. root:root 0600 outside the repository.
# No production connection or upload is configured by this example.
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSFILE=/etc/book_member_maker/backup.pgpass
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/book_member_maker/supabase-ca.crt
# Supabase remote connections need the official downloaded Supabase CA above.
DATABASE_MODE=remote
# Reuse the verified PG17 client. No PostgreSQL host package is required.
PGCLIENT_IMAGE=supabase/postgres@sha256:f371b5f3f2ac0a05703f33d6e6134515fb2498cab708fb948a0aeb7481467c00
PGCLIENT_NETWORK=host
# Future local mode: DATABASE_MODE=local, PGHOST=127.0.0.1, PGSSLMODE=disable,
# PGCLIENT_NETWORK=container:<verified-db-container-name>; no public DB port.
APP_ENV_FILE=/etc/book_member_maker/app.env
AGE_RECIPIENT=
# rclone remote must be an approved external storage provider, not local/alias.
BACKUP_REMOTE=
RCLONE_CONFIG=/etc/book_member_maker/rclone.conf
BACKUP_DIR=/var/lib/bookmembers-backup
BACKUP_HOST_STATE=true
WIKI_DATABASE=/var/lib/bookmembers-wiki/data.db
WIKI_IMAGES_DIR=/var/lib/bookmembers-wiki/data/images
WIKI_BRIDGE_ENV_FILE=/etc/bookmembers-wiki/bridge.env
WIKI_ENGINE_ENV_FILE=/etc/bookmembers-wiki/engine.env
# Set only after local production DB provisioning. Includes JWT/DB keys encrypted.
DATABASE_ENV_FILE=
